# Telegram Bot sozlamalari
BOT_TOKEN=
# Bot administratorlari (vergul bilan ajratilgan Telegram ID raqamlari)
ADMIN_IDS=

# Ma'lumotlar bazasi URL manzili (SQLite yoki PostgreSQL)
# SQLite uchun:
DATABASE_URL=sqlite+aiosqlite:///tasks.db
# PostgreSQL uchun (masalan):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/vazifabot

# Vaqt zonasi
TIMEZONE=Asia/Tashkent

# Hisobot vaqtlari (HH:MM)
MORNING_REPORT_TIME=09:00
EVENING_REPORT_TIME=19:00

# Mini App URL (Keyingi bosqichlar uchun)
WEBAPP_URL=https://your-railway-domain.up.railway.app

# Railway: mount a persistent volume at /data, then use:
# DATABASE_URL=sqlite+aiosqlite:////data/tasks.db
# Railway automatically provides PORT; the app binds the Mini App server to it.

